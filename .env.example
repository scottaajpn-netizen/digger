# Optional server-side integrations
# Create a free API key at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Optional identifier for polite MusicBrainz usage
# MUSICBRAINZ_USER_AGENT=Digger/0.3 (your contact URL or email)

# Optional Discogs editorial digging (server only; never NEXT_PUBLIC_).
# Generate a personal access token: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=
# DISCOGS_USER_AGENT=Digger/0.3 +https://github.com/scottaajpn-netizen/digger

# Local Soulseek/slskd integration (server only; never NEXT_PUBLIC_)
# SLSKD_URL=http://127.0.0.1:5030
SLSKD_API_KEY=
